package sys;

fun void memcpy(int8: from, int8: to, int64 length) {
    llvm#("""
entry:
  br label %copy_loop

copy_loop:
  %i = phi i64 [0, %entry], [%next, %copy_body]
  %done = icmp uge i64 %i, %length
  br i1 %done, label %copy_done, label %copy_body

copy_body:
  %src = getelementptr i8, ptr %from, i64 %i
  %dst = getelementptr i8, ptr %to, i64 %i
  %val = load i8, ptr %src
  store i8 %val, ptr %dst
  %next = add i64 %i, 1
  br label %copy_loop

copy_done:
  ret void
""");
}

fun int64 strlen(int8: str) {
    llvm#("""
entry:
  br label %strlen_loop

strlen_loop:
  %i = phi i64 [0, %entry], [%next, %strlen_loop]
  %ptr = getelementptr i8, ptr %str, i64 %i
  %ch = load i8, ptr %ptr
  %is_zero = icmp eq i8 %ch, 0
  %next = add i64 %i, 1
  br i1 %is_zero, label %strlen_done, label %strlen_loop

strlen_done:
  ret i64 %i
""");
}

fun void print(int8: str) {
    llvm#("""
entry:
  %len = call i64 @strlen(ptr %str)

  call void asm sideeffect "syscall",
    "{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}"(
      i64 1,
      i64 1,
      ptr %str,
      i64 %len
    )

  ret void
""");
}

fun void println(int8: str) {
    print(str);
    println();
}

fun void println() {
    llvm#("""
entry:
  %nl = alloca i8
  store i8 10, ptr %nl

  call void asm sideeffect "syscall",
    "{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}"(
      i64 1,
      i64 1,
      ptr %nl,
      i64 1
    )

  ret void
""");
}

fun void print(int64 number) {
    let int8: str = new int8[21];

    stringify(number, str);

    print(str);
}

fun void println(int64 number) {
    print(number);
    println();
}

fun void stringify(int64 number, int8: str) {
    llvm#("""
entry:
  %is_zero = icmp eq i64 %number, 0
  br i1 %is_zero, label %zero_case, label %convert_start

zero_case:
  store i8 48, ptr %str
  %zero_end = getelementptr i8, ptr %str, i64 1
  store i8 0, ptr %zero_end
  ret void

convert_start:
  %buf = alloca [21 x i8]
  br label %convert_loop

convert_loop:
  %n = phi i64 [%number, %convert_start], [%q, %convert_loop]
  %idx = phi i64 [20, %convert_start], [%prev_idx, %convert_loop]

  %q = udiv i64 %n, 10
  %r = urem i64 %n, 10
  %digit64 = add i64 %r, 48
  %digit = trunc i64 %digit64 to i8

  %slot = getelementptr [21 x i8], ptr %buf, i64 0, i64 %idx
  store i8 %digit, ptr %slot

  %prev_idx = sub i64 %idx, 1
  %more = icmp ne i64 %q, 0
  br i1 %more, label %convert_loop, label %copy_start

copy_start:
  %start = add i64 %prev_idx, 1
  br label %copy_loop

copy_loop:
  %read_idx = phi i64 [%start, %copy_start], [%next_read, %copy_loop]
  %write_idx = phi i64 [0, %copy_start], [%next_write, %copy_loop]

  %src = getelementptr [21 x i8], ptr %buf, i64 0, i64 %read_idx
  %dst = getelementptr i8, ptr %str, i64 %write_idx
  %ch = load i8, ptr %src
  store i8 %ch, ptr %dst

  %next_read = add i64 %read_idx, 1
  %next_write = add i64 %write_idx, 1

  %done = icmp ugt i64 %next_read, 20
  br i1 %done, label %copy_done, label %copy_loop

copy_done:
  %end = getelementptr i8, ptr %str, i64 %next_write
  store i8 0, ptr %end
  ret void
""");
}