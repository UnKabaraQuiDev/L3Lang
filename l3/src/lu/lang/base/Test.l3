package lu.lang.base;

import lu.lang.base.Test2;

let static int8 globalVar = 2;

fun int8 main() {
	
	let int8 a = 254;
	a = a+1;
	a = a+1;
	a = a+1;
	
	return a;
}

fun int16 strlen(let char: str) {
	asmln#(".find_length:");
	asm#("mov al, byte [rdi]     ; Load a byte from the string");
	asm#("test al, al            ; Check if the byte is null (0x00)");
	asm#("jz .length_found       ; If zero, we found the end");
	asm#("inc rcx                ; Increment the length counter");
	asm#("inc rdi                ; Move to the next character");
	asm#("jmp .find_length       ; Repeat");

	asmln#(".length_found:");
	asm#("mov rax, rcx");
	
	return;
}

fun int8 println(let char: str) {
	asm#("mov rsi, rdi");
	strlen(str);
	asm#("mov rdi, 1             ; File descriptor: 1 (stdout)");
	asm#("mov rdx, rax           ; Length of the string");
	asm#("mov rax, 1             ; System call number: 1 (write)");
	asm#("syscall ");
	
	return;
}

